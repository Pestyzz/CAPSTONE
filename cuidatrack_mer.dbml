// CuidaTrack — MER del núcleo transaccional (avance)
// Pégalo en https://dbdiagram.io para visualizarlo/editarlo
// Los nombres de las Ref (gestiona, recibe, indica, etc.) se ven al
// pasar el mouse sobre cada línea de relación en el diagrama.

Table CUIDADOR {
  cuidador_id int [pk, increment]
  nombre varchar
  email varchar [unique]
  telefono varchar
  fecha_registro datetime
}

Table PERSONA_MAYOR {
  persona_mayor_id int [pk, increment]
  nombre varchar
  fecha_nacimiento date
  nivel_dependencia varchar
  direccion varchar
}

Table ASIGNACION_CUIDADO {
  asignacion_id int [pk, increment]
  cuidador_id int
  persona_mayor_id int
  relacion_parentesco varchar
  fecha_inicio date
}

Table MEDICAMENTO {
  medicamento_id int [pk, increment]
  nombre varchar
  unidad_medida varchar
}

Table TRATAMIENTO {
  tratamiento_id int [pk, increment]
  persona_mayor_id int
  medicamento_id int
  dosis varchar
  hora_programada time
  fecha_inicio date
  fecha_fin date
}

Table REGISTRO_MEDICAMENTO {
  registro_id int [pk, increment]
  tratamiento_id int
  cuidador_id int
  fecha_hora datetime
  dentro_ventana boolean
  observacion varchar
}

Table ACTIVIDAD_CUIDADO {
  actividad_id int [pk, increment]
  persona_mayor_id int
  cuidador_id int
  tipo_actividad varchar
  fecha_hora datetime
  detalle varchar
  observacion varchar
}

Table CITA_MEDICA {
  cita_id int [pk, increment]
  persona_mayor_id int
  especialidad varchar
  fecha_hora datetime
  lugar varchar
  estado varchar
  notas varchar
}

Table EVALUACION_SOBRECARGA {
  evaluacion_id int [pk, increment]
  cuidador_id int
  fecha date
  puntaje_zarit int
  nivel_sobrecarga varchar
}

Table ALERTA {
  alerta_id int [pk, increment]
  persona_mayor_id int
  cuidador_id int
  tipo_alerta varchar
  fecha_generada datetime
  estado varchar
  descripcion varchar
}

// --- Relaciones (nombradas: el nombre se ve al hacer hover en el diagrama) ---

Ref gestiona: ASIGNACION_CUIDADO.cuidador_id > CUIDADOR.cuidador_id
Ref recibe_asignacion: ASIGNACION_CUIDADO.persona_mayor_id > PERSONA_MAYOR.persona_mayor_id

Ref indica: TRATAMIENTO.persona_mayor_id > PERSONA_MAYOR.persona_mayor_id
Ref compone: TRATAMIENTO.medicamento_id > MEDICAMENTO.medicamento_id

Ref genera: REGISTRO_MEDICAMENTO.tratamiento_id > TRATAMIENTO.tratamiento_id
Ref registra_medicamento: REGISTRO_MEDICAMENTO.cuidador_id > CUIDADOR.cuidador_id

Ref recibe_actividad: ACTIVIDAD_CUIDADO.persona_mayor_id > PERSONA_MAYOR.persona_mayor_id
Ref registra_actividad: ACTIVIDAD_CUIDADO.cuidador_id > CUIDADOR.cuidador_id

Ref agenda: CITA_MEDICA.persona_mayor_id > PERSONA_MAYOR.persona_mayor_id

Ref responde: EVALUACION_SOBRECARGA.cuidador_id > CUIDADOR.cuidador_id

Ref origina: ALERTA.persona_mayor_id > PERSONA_MAYOR.persona_mayor_id
Ref recibe_alerta: ALERTA.cuidador_id > CUIDADOR.cuidador_id
